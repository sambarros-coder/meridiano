# Copie para .env.local (não versionado) ou cadastre na Vercel em Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca colocar no código nem em variável com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo longo e aleatório, usado pelo agendador para chamar /api/coleta.
CRON_SECRET=
